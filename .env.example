# EZY1 Environment Variables

# Payment Gateway (Razorpay/Stripe)
VITE_PAYMENT_KEY_ID=your_payment_key_here
VITE_PAYMENT_SECRET=your_payment_secret_here

# AI Assistant
VITE_AI_API_KEY=your_openai_or_gemini_api_key
VITE_AI_MODEL=gpt-4-turbo # or gemini-pro

# Maps & Location API (Google Maps / Mapbox)
VITE_MAP_API_KEY=your_map_api_key

# Database / Auth (If not using ICP natively)
VITE_DB_URL=your_db_url
VITE_FRONTEND_URL=https://ezy1.site
