# EZY1 Environment Variables

# Server & Database Configuration
PORT=3000
DATABASE_URL=./database.sqlite
JWT_SECRET=your_production_jwt_signing_secret_here

# Production Real Phone SMS / OTP Gateway Configuration
# Supported providers: "twilio", "msg91", "fast2sms", "textlocal", "whatsapp"
OTP_PROVIDER=msg91
OTP_API_KEY=your_sms_provider_api_key
OTP_API_SECRET=your_sms_provider_api_secret
OTP_SENDER_ID=your_dlt_registered_sender_id
OTP_TEMPLATE_ID=your_dlt_registered_template_id

# Specific Provider Overrides (Optional)
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# MSG91 (India DLT Compliant)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Fast2SMS (India High-Speed OTP Route)
FAST2SMS_API_KEY=

# Textlocal (India Transactional SMS)
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# Development / Automated Testing Flag
# Strictly false in production. When false, demo/test OTPs are permanently disabled.
ENABLE_TEST_OTP=false

# Payment Gateway (Razorpay/Stripe)
VITE_PAYMENT_KEY_ID=your_payment_key_here
VITE_PAYMENT_SECRET=your_payment_secret_here

# AI Assistant
VITE_AI_API_KEY=your_openai_or_gemini_api_key
VITE_AI_MODEL=gpt-4-turbo

# Maps & Location API
VITE_MAP_API_KEY=your_map_api_key

# Frontend URLs
VITE_FRONTEND_URL=https://ezy1.site
