datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// ---------------------------------------------------------
// 1. IDENTITY & CUSTOMER DOMAIN
// ---------------------------------------------------------

enum UserRole {
  CUSTOMER
  PARTNER
  PARTNER_STAFF
  DRIVER
  ADMIN
  SUPER_ADMIN
  OWNER
  SUPER_OWNER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DEACTIVATED
}

model User {
  id                 Int           @id @default(autoincrement())
  username           String?       @unique
  email              String?       @unique
  passwordHash       String?
  name               String
  phone              String?       @unique
  city               String?
  role               UserRole      @default(CUSTOMER)
  status             AccountStatus @default(ACTIVE)
  walletBalance      Decimal       @default(0.0) @db.Decimal(12, 2)
  avatar             String?
  googleId           String?
  mustChangePassword Boolean       @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  addresses          Address[]
  orders             Order[]
  bookings           Booking[]
  reviews            Review[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  locations          Location[]
  hotelBookings      HotelBooking[]
  travelBookings     TravelBooking[]
  busBookings        BusBooking[]
  rideBookings       SharedRideBooking[]
  homeHealthBookings HomeHealthcareBooking[]
  diagnosticBookings DiagnosticBooking[]
  partnerApp         PartnerApplication[]

  partnerAccount     Partner?      @relation("PartnerUser")
  staffAccount       PartnerStaff? @relation("StaffUser")

  @@index([role, status])
  @@index([email])
  @@index([phone])
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  type         String   @default("Home") // "Home", "Work", "Other"
  receiverName String
  phone        String
  street       String
  locality     String
  city         String
  state        String
  pincode      String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Location {
  id               Int      @id @default(autoincrement())
  userId           Int
  latitude         Float
  longitude        Float
  accuracy         Float?
  formattedAddress String
  locality         String?
  city             String?
  district         String?
  state            String?
  pincode          String?
  country          String?
  source           String   @default("GPS")
  label            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OTP {
  id         Int      @id @default(autoincrement())
  phone      String
  otpHash    String
  plainOtp   String?
  expiresAt  BigInt
  attempts   Int      @default(0)
  lastSentAt BigInt
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([phone])
}

model NotificationPreference {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  orders        Boolean  @default(true)
  delivery      Boolean  @default(true)
  bookings      Boolean  @default(true)
  bus           Boolean  @default(true)
  doctor        Boolean  @default(true)
  hospital      Boolean  @default(true)
  services      Boolean  @default(true)
  offers        Boolean  @default(true)
  announcements Boolean  @default(true)
  pushEnabled   Boolean  @default(true)
  smsEnabled    Boolean  @default(true)
  emailEnabled  Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model PushToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  token      String   @unique
  deviceInfo String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------
// 2. PARTNER & PROVIDER MULTI-TENANT DOMAIN
// ---------------------------------------------------------

enum PartnerProviderType {
  GROCERY
  VENDOR
  HOSPITAL
  CLINIC
  HEALTHCARE
  PHARMACY
  RESTAURANT
  DELIVERY
  SERVICE_PROVIDER
  HOTEL
  TRAVEL
  BUS
  OWNER
  ADMIN
}

model Partner {
  id                Int                 @id @default(autoincrement())
  partnerUserId     String              @unique // e.g. "EZY-P-10001"
  userId            Int?                @unique
  businessName      String
  ownerName         String
  category          String              @default("General")
  providerType      PartnerProviderType @default(GROCERY)
  status            AccountStatus       @default(ACTIVE)
  isVerified        Boolean             @default(true)
  phone             String              @unique
  email             String              @unique
  city              String
  address           String?
  latitude          Float?
  longitude         Float?
  rating            Float               @default(5.0)
  totalRatings      Int                 @default(0)
  commissionRate    Decimal       @default(10.0) @db.Decimal(5, 2)
  walletBalance      Decimal       @default(0.0) @db.Decimal(12, 2)
  pendingSettlement Decimal       @default(0.0) @db.Decimal(12, 2)
  mustChangePassword Boolean            @default(false)
  passwordHash      String?
  failedAttempts    Int                 @default(0)
  lockedUntil       BigInt?
  lastLoginAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user              User?               @relation("PartnerUser", fields: [userId], references: [id])
  staff             PartnerStaff[]
  kyc               PartnerKYC?
  bankDetails       PartnerBankDetails?
  products          Product[]
  services          Service[]
  orders            Order[]
  bookings          Booking[]
  settlements       Settlement[]
  inventoryItems    InventoryItem[]
  hospitalBeds      HospitalBed[]
  hospitalDoctors   HospitalDoctor[]
  appointments      HospitalAppointment[]
  medicines         PharmacyMedicine[]
  menuItems         RestaurantMenuItem[]
  deliveries        DeliveryAssignment[]

  @@index([status, providerType])
  @@index([city])
  @@index([partnerUserId])
}

model PartnerApplication {
  id             Int           @id @default(autoincrement())
  userId         Int
  businessName   String
  partnerType    String
  category       String
  ownerName      String
  address        String
  city           String
  district       String
  state          String
  pincode        String
  latitude       Float?
  longitude      Float?
  operatingHours String?
  serviceArea    String?
  deliveryRadius Float?
  status         AccountStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model PartnerStaff {
  id          Int           @id @default(autoincrement())
  partnerId   Int
  userId      Int           @unique
  staffRole   String        @default("OPERATIONS")
  permissions Json
  status      AccountStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())

  partner     Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user        User          @relation("StaffUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model PartnerKYC {
  id             Int       @id @default(autoincrement())
  partnerId      Int       @unique
  panNumber      String
  gstin          String?
  tradeLicense   String?
  panDocPath     String?
  gstDocPath     String?
  licenseDocPath String?
  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
  verifiedBy     Int?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  partner        Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model PartnerBankDetails {
  id              Int      @id @default(autoincrement())
  partnerId       Int      @unique
  accountNumber   String
  ifscCode        String
  bankName        String
  beneficiaryName String
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())

  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// 3. CATALOG: PRODUCTS, SERVICES & INVENTORY
// ---------------------------------------------------------

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)

  products    Product[]
  services    Service[]
}

model Product {
  id            Int            @id @default(autoincrement())
  partnerId     Int
  categoryId    Int
  name          String
  description   String?
  price           Decimal       @db.Decimal(10, 2)
  mrp             Decimal?      @db.Decimal(10, 2)
  unit          String         @default("piece")
  sku           String?
  barcode       String?
  imageUrl      String?
  galleryImages String[]       @default([])
  isAvailable   Boolean        @default(true)
  stockQuantity Int            @default(100)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  partner       Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  inventory     InventoryItem?

  @@index([partnerId, isAvailable])
  @@index([categoryId])
  @@index([name])
}

model Service {
  id              Int           @id @default(autoincrement())
  partnerId       Int
  categoryId      Int
  title           String
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  durationMinutes Int           @default(60)
  serviceType     String        @default("HOME")
  imageUrl        String?
  isAvailable     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category        Category      @relation(fields: [categoryId], references: [id])
  bookingItems    BookingItem[]

  @@index([partnerId, isAvailable])
  @@index([categoryId])
}

model InventoryItem {
  id            Int      @id @default(autoincrement())
  partnerId     Int
  productId     Int      @unique
  inStock       Int      @default(0)
  reserved      Int      @default(0)
  lowStockAlert Int      @default(5)
  lastRestocked DateTime @default(now())

  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

// ---------------------------------------------------------
// 4. ORDERS, BOOKINGS & TRANSACTIONS
// ---------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Order {
  id                Int         @id @default(autoincrement())
  orderNumber       String      @unique
  userId            Int
  partnerId         Int
  status            OrderStatus @default(PENDING)
  subtotal          Decimal       @db.Decimal(12, 2)
  deliveryFee       Decimal       @default(0.0) @db.Decimal(10, 2)
  discountAmount    Decimal       @default(0.0) @db.Decimal(10, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  idempotencyKey    String?     @unique
  deliveryAddress   Json
  estimatedDelivery DateTime?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id])
  partner           Partner     @relation(fields: [partnerId], references: [id])
  items             OrderItem[]
  payments          Payment[]

  @@index([userId, status])
  @@index([partnerId, status])
  @@index([createdAt])
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  productId  Int
  unitPrice         Decimal       @db.Decimal(10, 2)
  quantity   Int     @default(1)
  totalPrice        Decimal       @db.Decimal(12, 2)

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Booking {
  id              Int           @id @default(autoincrement())
  bookingNumber   String        @unique
  userId          Int
  partnerId       Int
  status          BookingStatus @default(PENDING)
  totalAmount       Decimal       @db.Decimal(12, 2)
  scheduledDate   DateTime
  scheduledSlot   String
  customerAddress Json?
  idempotencyKey  String?       @unique
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  partner         Partner       @relation(fields: [partnerId], references: [id])
  items           BookingItem[]
  payments        Payment[]

  @@index([userId, status])
  @@index([partnerId, scheduledDate])
}

model BookingItem {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  serviceId  Int
  unitPrice         Decimal       @db.Decimal(10, 2)
  quantity   Int      @default(1)
  totalPrice        Decimal       @db.Decimal(12, 2)

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
}

// ---------------------------------------------------------
// 5. PAYMENTS, SETTLEMENTS & REFUNDS
// ---------------------------------------------------------

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Payment {
  id               Int           @id @default(autoincrement())
  paymentNumber    String        @unique
  orderId          Int?
  bookingId        Int?
  userId           Int
  amount            Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR")
  gateway          String        @default("RAZORPAY")
  gatewayOrderId   String?
  gatewayPaymentId String?       @unique
  gatewaySignature String?
  status           PaymentStatus @default(CREATED)
  idempotencyKey   String?       @unique
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order            Order?        @relation(fields: [orderId], references: [id])
  booking          Booking?      @relation(fields: [bookingId], references: [id])
  refunds          Refund[]

  @@index([gatewayOrderId])
  @@index([status])
}

model Settlement {
  id           Int       @id @default(autoincrement())
  partnerId    Int
  periodStart  DateTime
  periodEnd    DateTime
  grossSales        Decimal       @db.Decimal(12, 2)
  platformFee       Decimal       @db.Decimal(12, 2)
  taxDeduction      Decimal       @default(0.0) @db.Decimal(12, 2)
  netPayout         Decimal       @db.Decimal(12, 2)
  status       String    @default("PENDING")
  utrReference String?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  partner      Partner   @relation(fields: [partnerId], references: [id])

  @@index([partnerId, status])
}

model Refund {
  id              Int       @id @default(autoincrement())
  paymentId       Int
  amount            Decimal       @db.Decimal(12, 2)
  reason          String
  status          String    @default("PENDING")
  gatewayRefundId String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  payment         Payment   @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

// ---------------------------------------------------------
// 6. HEALTHCARE: BEDS, DOCTORS, APPOINTMENTS, MEDICINES
// ---------------------------------------------------------

model HospitalBed {
  id          Int      @id @default(autoincrement())
  partnerId   Int
  ward        String
  bedNumber   String
  bedType     String   @default("GENERAL")
  status      String   @default("AVAILABLE")
  patientName String?
  dailyRate         Decimal       @default(1500.0) @db.Decimal(10, 2)
  updatedAt   DateTime @updatedAt

  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model HospitalDoctor {
  id              Int                   @id @default(autoincrement())
  partnerId       Int
  name            String
  specialty       String
  department      String
  qualification   String?
  experienceYears Int                   @default(5)
  consultationFee   Decimal       @default(500.0) @db.Decimal(10, 2)
  availability    String                @default("Mon-Fri 09:00 - 17:00")
  status          String                @default("AVAILABLE")

  partner         Partner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  appointments    HospitalAppointment[]

  @@index([partnerId])
}

model HospitalAppointment {
  id              Int             @id @default(autoincrement())
  partnerId       Int
  doctorId        Int?
  patientName     String
  patientPhone    String
  appointmentDate String
  timeSlot        String
  status          String          @default("CONFIRMED")
  notes           String?
  createdAt       DateTime        @default(now())

  partner         Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  doctor          HospitalDoctor? @relation(fields: [doctorId], references: [id])

  @@index([partnerId])
}

model PharmacyMedicine {
  id                   Int      @id @default(autoincrement())
  partnerId            Int
  name                 String
  genericName          String?
  category             String   @default("General")
  price           Decimal       @db.Decimal(10, 2)
  stockQuantity        Int      @default(100)
  requiresPrescription Boolean  @default(false)
  dosage               String?
  status               String   @default("IN_STOCK")
  createdAt            DateTime @default(now())

  partner              Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

// ---------------------------------------------------------
// 7. RESTAURANTS & FOOD DELIVERY
// ---------------------------------------------------------

model RestaurantMenuItem {
  id                 Int      @id @default(autoincrement())
  partnerId          Int
  name               String
  category           String   @default("Main Course")
  price           Decimal       @db.Decimal(10, 2)
  isVeg              Boolean  @default(true)
  available          Boolean  @default(true)
  description        String?
  preparationTimeMin Int      @default(20)
  createdAt          DateTime @default(now())

  partner            Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model DeliveryAssignment {
  id              Int      @id @default(autoincrement())
  partnerId       Int
  orderId         Int?
  pickupAddress   String
  deliveryAddress String
  status          String   @default("ASSIGNED")
  earnings          Decimal       @default(60.0) @db.Decimal(10, 2)
  distanceKm      Float    @default(3.5)
  createdAt       DateTime @default(now())

  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

// ---------------------------------------------------------
// 8. STAYS, TRAVEL, BUSES, RIDES, HOME HEALTHCARE, DIAGNOSTICS
// ---------------------------------------------------------

model Hotel {
  id             Int            @id @default(autoincrement())
  partnerId      Int?
  name           String
  type           String         @default("HOTEL")
  city           String
  address        String
  rating         Float          @default(4.5)
  pricePerNight     Decimal       @db.Decimal(10, 2)
  originalPrice     Decimal?      @db.Decimal(10, 2)
  amenities      String?
  image          String?
  availableRooms Int            @default(10)
  totalRooms     Int            @default(20)
  checkInTime    String         @default("12:00 PM")
  checkOutTime   String         @default("11:00 AM")
  status         String         @default("AVAILABLE")
  createdAt      DateTime       @default(now())

  bookings       HotelBooking[]

  @@index([city])
}

model HotelBooking {
  id           Int      @id @default(autoincrement())
  userId       Int
  hotelId      Int
  checkInDate  String
  checkOutDate String
  guestsCount  Int      @default(1)
  roomsCount   Int      @default(1)
  totalAmount       Decimal       @db.Decimal(12, 2)
  guestName    String
  guestPhone   String
  status       String   @default("CONFIRMED")
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
  hotel        Hotel    @relation(fields: [hotelId], references: [id])

  @@index([userId])
}

model TravelPackage {
  id                Int             @id @default(autoincrement())
  title             String
  agencyName        String
  agencyPhone       String?
  destination       String
  duration          String
  price           Decimal       @db.Decimal(10, 2)
  rating            Float           @default(4.8)
  itinerary         String?
  includedAmenities String?
  image             String?
  type              String          @default("LOCAL_TOUR")
  availableSeats    Int             @default(15)
  createdAt         DateTime        @default(now())

  bookings          TravelBooking[]

  @@index([destination])
}

model TravelBooking {
  id              Int           @id @default(autoincrement())
  userId          Int
  packageId       Int
  travelDate      String
  travelersCount  Int           @default(1)
  totalAmount       Decimal       @db.Decimal(12, 2)
  travelerName    String
  travelerPhone   String
  status          String        @default("CONFIRMED")
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id])
  package         TravelPackage @relation(fields: [packageId], references: [id])

  @@index([userId])
}

model Bus {
  id             Int          @id @default(autoincrement())
  busNumber      String
  operatorName   String
  sourceCity     String
  destinationCity String
  departureTime  String
  arrivalTime    String
  price           Decimal       @db.Decimal(10, 2)
  rating         Float        @default(4.6)
  busType        String       @default("AC Sleeper")
  availableSeats Int          @default(30)
  totalSeats     Int          @default(40)
  createdAt      DateTime     @default(now())

  bookings       BusBooking[]

  @@index([sourceCity, destinationCity])
}

model BusBooking {
  id            Int      @id @default(autoincrement())
  userId        Int
  busId         Int
  journeyDate   String
  seatNumbers   String
  passengersCount Int    @default(1)
  totalAmount       Decimal       @db.Decimal(12, 2)
  contactName   String
  contactPhone  String
  status        String   @default("CONFIRMED")
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
  bus           Bus      @relation(fields: [busId], references: [id])

  @@index([userId])
}

model SharedRide {
  id              Int                 @id @default(autoincrement())
  driverName      String
  driverPhone     String
  vehicleModel    String
  vehicleNumber   String
  fromLocation    String
  toLocation      String
  departureTime   String
  pricePerSeat      Decimal       @db.Decimal(10, 2)
  availableSeats  Int                 @default(3)
  totalSeats      Int                 @default(4)
  rideType        String              @default("CAR")
  createdAt       DateTime            @default(now())

  bookings        SharedRideBooking[]

  @@index([fromLocation, toLocation])
}

model SharedRideBooking {
  id             Int        @id @default(autoincrement())
  userId         Int
  rideId         Int
  rideDate       String
  seatsBooked    Int        @default(1)
  totalAmount       Decimal       @db.Decimal(12, 2)
  passengerName  String
  passengerPhone String
  status         String     @default("CONFIRMED")
  createdAt      DateTime   @default(now())

  user           User       @relation(fields: [userId], references: [id])
  ride           SharedRide @relation(fields: [rideId], references: [id])

  @@index([userId])
}

model HomeHealthcareService {
  id              Int                     @id @default(autoincrement())
  title           String
  category        String                  @default("Nursing")
  price           Decimal       @db.Decimal(10, 2)
  duration        String                  @default("Per Visit (1-2 hrs)")
  description     String
  features        String?
  rating          Float                   @default(4.8)
  available       Boolean                 @default(true)
  createdAt       DateTime                @default(now())

  bookings        HomeHealthcareBooking[]
}

model HomeHealthcareBooking {
  id              Int                   @id @default(autoincrement())
  userId          Int
  serviceId       Int
  bookingDate     String
  timeSlot        String
  patientName     String
  patientPhone    String
  patientAddress  String
  totalAmount       Decimal       @db.Decimal(12, 2)
  status          String                @default("CONFIRMED")
  createdAt       DateTime              @default(now())

  user            User                  @relation(fields: [userId], references: [id])
  service         HomeHealthcareService @relation(fields: [serviceId], references: [id])

  @@index([userId])
}

model DiagnosticTest {
  id              Int                 @id @default(autoincrement())
  name            String
  category        String              @default("Blood Test")
  price           Decimal       @db.Decimal(10, 2)
  originalPrice     Decimal?      @db.Decimal(10, 2)
  reportTimeHours Int                 @default(24)
  sampleType      String              @default("Blood")
  fastingRequired Boolean             @default(false)
  createdAt       DateTime            @default(now())

  bookings        DiagnosticBooking[]
}

model DiagnosticBooking {
  id             Int            @id @default(autoincrement())
  userId         Int
  testId         Int
  bookingDate    String
  timeSlot       String
  patientName    String
  patientPhone   String
  patientAddress String
  totalAmount       Decimal       @db.Decimal(12, 2)
  status         String         @default("CONFIRMED")
  createdAt      DateTime       @default(now())

  user           User           @relation(fields: [userId], references: [id])
  test           DiagnosticTest @relation(fields: [testId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------
// 9. CMS, REVIEWS, COUPONS & AUDIT LOGS
// ---------------------------------------------------------

model CMSBanner {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String?
  imageUrl  String
  targetUrl String?
  location  String   @default("HOMEPAGE_HERO")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model CMSPage {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  partnerId  Int?
  productId  Int?
  rating     Int
  comment    String
  isReported Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([partnerId])
  @@index([productId])
}

model Coupon {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  discountType  String
  discountValue     Decimal       @db.Decimal(10, 2)
  minOrderValue     Decimal       @default(0.0) @db.Decimal(10, 2)
  maxDiscount       Decimal?      @db.Decimal(10, 2)
  usageLimit    Int?
  usedCount     Int      @default(0)
  validFrom     DateTime @default(now())
  validUntil    DateTime
  isActive      Boolean  @default(true)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  type      String   @default("ORDER")
  category  String   @default("SYSTEM")
  priority  String   @default("NORMAL")
  data      String?
  actionUrl String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  channel   String   @default("IN_APP")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  resource  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([action, createdAt])
  @@index([resource])
}
