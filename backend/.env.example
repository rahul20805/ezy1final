# ==============================================================================
# EZY1 ENTERPRISE PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development
CORS_ORIGINS=https://ezy1.site,https://partner.ezy1.site,https://admin.ezy1.site,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ezy1_db?schema=public"

# Optional Fallback SQLite Database Path
DB_PATH=../src/server/database.sqlite

# Security & Authentication
JWT_SECRET=ezy1_production_jwt_secret_super_secure_key_2026_min32chars
SESSION_SECRET=ezy1_session_encryption_key_2026

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Production Multi-Provider SMS / OTP Engine
# Options: "msg91", "fast2sms", "twilio", "textlocal", "whatsapp"
OTP_PROVIDER=msg91
OTP_API_KEY=your_sms_provider_api_key
OTP_API_SECRET=your_sms_provider_api_secret
OTP_SENDER_ID=your_dlt_registered_sender_id
OTP_TEMPLATE_ID=your_dlt_registered_template_id

# SMS Provider Overrides (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
FAST2SMS_API_KEY=
TEXTLOCAL_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Allow test OTPs in non-production environments
ENABLE_TEST_OTP=false

# Transactional Email Engine (Brevo / Nodemailer)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=support@ezy1.site
SMTP_PASS=your_brevo_smtp_password
BREVO_API_KEY=your_brevo_api_key
IMPROVX_API_KEY=your_improvx_key
ADMIN_NOTIFICATION_EMAIL=admin@ezy1.site
OWNER_NOTIFICATION_EMAIL=owner@ezy1.site

# Object Storage & KYC Document Engine (AWS S3 / Cloudflare R2)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KYC_BUCKET=ezy1-partner-kyc-private
AWS_PUBLIC_BUCKET=ezy1-public-media
CDN_BASE_URL=https://cdn.ezy1.site

# Asynchronous Background Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379

# AI Assistant & Concierge (OpenAI)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
